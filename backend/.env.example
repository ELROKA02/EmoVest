# Base de datos local.
DATABASE_URL=mysql+pymysql://emovest:emovest_dev@localhost:3306/emovest

# Auth local. Cambia este valor en cualquier entorno compartido.
SECRET_KEY=dev-secret-change-me
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080

# Redis y cola RQ.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=emociones
RQ_DEFAULT_TIMEOUT=180
RQ_RESULT_TTL=3600
RQ_FAILURE_TTL=86400
RQ_RETRY_MAX=3

# Ollama local.
OLLAMA_HOST=http://localhost:11434

# Capturas de operaciones.
IMAGE_STORAGE_DIR=images
MAX_IMAGE_SIZE_MB=5

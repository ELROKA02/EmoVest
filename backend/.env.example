# EmoVest Desktop. Tauri proporciona estas rutas absolutas al sidecar.
APP_MODE=desktop
EMOVEST_APP_VERSION=0.4.0
EMOVEST_DATA_DIR=C:/Users/YourName/AppData/Local/EmoVest
EMOVEST_CONFIG_DIR=C:/Users/YourName/AppData/Roaming/EmoVest
EMOVEST_LOG_DIR=C:/Users/YourName/AppData/Local/EmoVest/logs
EMOVEST_DATABASE_PATH=C:/Users/YourName/AppData/Local/EmoVest/emovest.sqlite3
EMOVEST_BACKUP_DIR=C:/Users/YourName/AppData/Local/EmoVest/backups
EMOVEST_MODEL_DIR=C:/Users/YourName/AppData/Local/EmoVest/models
IMAGE_STORAGE_DIR=C:/Users/YourName/AppData/Local/EmoVest/images

# SQLite y conservación de copias previas a migraciones.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_BACKUP_RETENTION=5

# Cola persistente local y limpieza de registros de runtime.
LOCAL_QUEUE_POLL_INTERVAL_SECONDS=0.5
LOCAL_QUEUE_LEASE_SECONDS=180
LOCAL_QUEUE_MAX_ATTEMPTS=4
LOCAL_QUEUE_SHUTDOWN_TIMEOUT_SECONDS=10
LOCAL_QUEUE_ERROR_BACKOFF_SECONDS=0.5
LOCAL_QUEUE_ERROR_MAX_BACKOFF_SECONDS=30
LOCAL_RUNTIME_CLEANUP_INTERVAL_SECONDS=3600
LOCAL_JOB_RETENTION_SECONDS=2592000
LOCAL_RUNTIME_CLEANUP_BATCH_SIZE=500
CHAT_SESSION_TTL_SECONDS=28800

# La clave JWT se genera y persiste automáticamente en EMOVEST_CONFIG_DIR.
FRONTEND_URL=tauri://localhost
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:5173,http://127.0.0.1:5173

# IA opcional. Desactivar cualquiera de los casos no impide usar el diario.
AI_EMOTION_ENABLED=true
AI_CHAT_ENABLED=true
AI_PROVIDER=ollama
AI_MODEL=clasificador_emociones_gemma4:latest
AI_BASE_URL=http://localhost:11434
AI_INSTALL_MODE=manual
AI_EMOTION_PROVIDER=ollama
AI_EMOTION_MODEL=clasificador_emociones_gemma4:latest
AI_EMOTION_BASE_URL=http://localhost:11434
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=qwen3.5:latest
AI_CHAT_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Proveedores avanzados opcionales.
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_API_KEY=
LLAMACPP_TOOL_CALLING_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_TOOL_CALLING_MODELS=

MAX_IMAGE_SIZE_MB=5

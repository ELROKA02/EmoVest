# Base de datos local.
DATABASE_URL=mysql+pymysql://emovest:emovest_dev@localhost:3306/emovest

# Auth local. Cambia este valor en cualquier entorno compartido.
SECRET_KEY=dev-secret-change-me
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080

# Redis y cola RQ.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=emociones
RQ_DEFAULT_TIMEOUT=180
RQ_RESULT_TTL=3600
RQ_FAILURE_TTL=86400
RQ_RETRY_MAX=3

# IA local. Ollama sigue siendo el proveedor recomendado por defecto.
AI_PROVIDER=ollama
AI_MODEL=clasificador_emociones_gemma4:latest
AI_BASE_URL=http://localhost:11434
AI_INSTALL_MODE=manual

# IA para clasificar emociones. Puede usar un modelo distinto al chat.
AI_EMOTION_PROVIDER=ollama
AI_EMOTION_MODEL=clasificador_emociones_gemma4:latest
AI_EMOTION_BASE_URL=http://localhost:11434

# IA para chat conversacional.
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=qwen3.5:latest
AI_CHAT_BASE_URL=http://localhost:11434

# Compatibilidad con instalaciones actuales basadas en Ollama.
OLLAMA_HOST=http://localhost:11434

# llama.cpp queda preparado como proveedor avanzado cuando se use llama-server.
LLAMACPP_BASE_URL=http://localhost:8080
# Modelos de llama.cpp/OpenRouter habilitados explícitamente para tool calling.
LLAMACPP_TOOL_CALLING_MODELS=

# Proveedor externo opcional. La clave debe mantenerse solo en el entorno del servidor.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_TOOL_CALLING_MODELS=

# Capturas de operaciones.
IMAGE_STORAGE_DIR=images
MAX_IMAGE_SIZE_MB=5

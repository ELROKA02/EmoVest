# Frontend servido por Caddy local
VITE_API_URL=/api
FRONTEND_URL=http://localhost:8080
WEB_PORT=8080

# MySQL local en Docker
MYSQL_DATABASE=emovest
MYSQL_USER=emovest
MYSQL_PASSWORD=emovest_dev
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_PORT=3307
DATABASE_URL=mysql+pymysql://emovest:emovest_dev@mysql:3306/emovest

# Redis local en Docker
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380
RQ_QUEUE_NAME=emociones

# Auth local. Cambiar si necesitas simular sesiones persistentes entre reinicios.
SECRET_KEY=local-server-dev-secret-change-me
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# IA local. Ollama corre fuera de Docker, en la maquina host.
AI_PROVIDER=ollama
AI_MODEL=clasificador_emociones_gemma4:latest
AI_BASE_URL=http://host.docker.internal:11434
AI_INSTALL_MODE=manual

# IA para clasificar emociones. Puede usar un modelo distinto al chat.
AI_EMOTION_PROVIDER=ollama
AI_EMOTION_MODEL=clasificador_emociones_gemma4:latest
AI_EMOTION_BASE_URL=http://host.docker.internal:11434

# IA para chat conversacional.
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=llama3.2:3b
AI_CHAT_BASE_URL=http://host.docker.internal:11434

# Compatibilidad con instalaciones actuales basadas en Ollama.
OLLAMA_HOST=http://host.docker.internal:11434

# llama.cpp queda preparado como proveedor avanzado cuando se use llama-server.
LLAMACPP_BASE_URL=http://host.docker.internal:8080

# Imagenes de operaciones dentro del contenedor.
IMAGE_STORAGE_DIR=/app/images
MAX_IMAGE_SIZE_MB=5
